import: cabal.project

-- AtCoder's Haskell environment as of the 2025-10 judge update
-- (used in contests in 2026): GHC 9.8.4 / base 4.19.2.0.
constraints:
  attoparsec == 0.14.4,
  bytestring == 0.12.2.0,
  containers == 0.8,
  extra == 1.8,
  mtl == 2.3.1,
  primitive == 0.9.1.0,
  text == 2.1.3,
  unordered-containers == 0.2.20,
  vector == 0.13.2.0,
  ac-library-hs == 1.5.3.0
