#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONTESTS_DIR="$ROOT/contests"
BUILD_SRC="$ROOT/.build/Main.hs"
TEMPLATE_SRC="$ROOT/templates/Main.hs"

# AtCoder answers bursts of requests with 429 Too Many Requests, so `hc new`
# spaces its requests out and retries a failed sample download.
REQUEST_INTERVAL="${HC_REQUEST_INTERVAL:-2}"  # seconds before each download
DOWNLOAD_ATTEMPTS="${HC_DOWNLOAD_ATTEMPTS:-3}"
RETRY_WAIT="${HC_RETRY_WAIT:-10}"             # seconds before each retry

die() {
  printf 'hc: %s\n' "$*" >&2
  exit 2
}

note() {
  printf '==> %s\n' "$*" >&2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is required but was not found in PATH"
}

# Bash 3.2 (the version shipped with macOS) lacks the ${var,,} expansion.
to_lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

normalize_task_id() {
  local contest="$1"
  local task="$2"

  if [[ "$task" == *_* ]]; then
    printf '%s\n' "$task"
  else
    printf '%s_%s\n' "$contest" "$(to_lower "$task")"
  fi
}

is_problem_dir() {
  [[ -f "$1/Main.hs" && -d "$1/test" ]]
}

has_samples() {
  local dir="$1"
  local f
  [[ -d "$dir/test" ]] || return 1
  for f in "$dir"/test/*.in; do
    [[ -f "$f" ]] && return 0
  done
  return 1
}

contest_url() {
  printf 'https://atcoder.jp/contests/%s\n' "$1"
}

problem_url() {
  printf 'https://atcoder.jp/contests/%s/tasks/%s\n' "$1" "$2"
}

# https://atcoder.jp/contests/abc465            -> abc465
# https://atcoder.jp/contests/abc465/tasks/...  -> abc465
contest_id_from_url() {
  local url="$1"
  local rest
  [[ "$url" == */contests/* ]] || return 1
  rest="${url#*/contests/}"
  printf '%s\n' "${rest%%/*}"
}

resolve_problem() {
  local a="${1:-}"
  local b="${2:-}"
  local cwd
  cwd="$(pwd -P)"

  PROBLEM_DIR=""
  CONTEST_ID=""
  PROBLEM_ID=""

  # hc test            (when cwd is contests/<contest>/<problem>)
  if [[ -z "$a" ]]; then
    if [[ "$cwd" == "$CONTESTS_DIR/"*/* ]] && is_problem_dir "$cwd"; then
      PROBLEM_DIR="$cwd"
      PROBLEM_ID="$(basename "$PROBLEM_DIR")"
      CONTEST_ID="$(basename "$(dirname "$PROBLEM_DIR")")"
    else
      die "task is required (or run inside a problem directory)"
    fi

  # hc test abc473 a
  elif [[ -n "$b" ]]; then
    CONTEST_ID="$a"
    PROBLEM_ID="$(normalize_task_id "$CONTEST_ID" "$b")"
    PROBLEM_DIR="$CONTESTS_DIR/$CONTEST_ID/$PROBLEM_ID"

  # hc test a          (when cwd is contests/abc473)
  elif [[ "$cwd" == "$CONTESTS_DIR/"* && "$(dirname "$cwd")" == "$CONTESTS_DIR" ]]; then
    CONTEST_ID="$(basename "$cwd")"
    PROBLEM_ID="$(normalize_task_id "$CONTEST_ID" "$a")"
    PROBLEM_DIR="$cwd/$PROBLEM_ID"

  # hc test abc473_a   (from anywhere)
  elif [[ "$a" == *_* ]]; then
    PROBLEM_ID="$a"
    CONTEST_ID="${a%_*}"
    PROBLEM_DIR="$CONTESTS_DIR/$CONTEST_ID/$PROBLEM_ID"

  # hc test path/to/problem
  elif [[ -d "$a" ]] && is_problem_dir "$(cd "$a" && pwd -P)"; then
    PROBLEM_DIR="$(cd "$a" && pwd -P)"
    PROBLEM_ID="$(basename "$PROBLEM_DIR")"
    CONTEST_ID="$(basename "$(dirname "$PROBLEM_DIR")")"

  else
    die "cannot resolve task '$a'. Run inside contests/<contest>, use a full problem id, or pass CONTEST TASK."
  fi

  [[ -f "$PROBLEM_DIR/Main.hs" ]] || die "Main.hs not found: $PROBLEM_DIR/Main.hs"
  [[ -d "$PROBLEM_DIR/test" ]] || die "test directory not found: $PROBLEM_DIR/test"

  SRC="$PROBLEM_DIR/Main.hs"
  URL="https://atcoder.jp/contests/$CONTEST_ID/tasks/$PROBLEM_ID"
}

sync_source() {
  mkdir -p "$ROOT/.build"
  cp "$SRC" "$BUILD_SRC"
}

# macOS: `xcrun` resolves to the newest installed SDK, which can be newer than
# the Command Line Tools linker supports. A MacOSX27 SDK with the CLT 26.x `ld`
# breaks every link with:
#   ld: tapi error: malformed file ... unknown architecture arm64e.x1-macos
# Pin SDKROOT to the newest SDK matching the running macOS major version.
ensure_sdkroot() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  [[ -n "${SDKROOT:-}" ]] && return 0
  command -v xcrun >/dev/null 2>&1 || return 0

  local os_major sdk_path sdk_major sdks_dir candidate
  os_major="$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)" || return 0
  sdk_path="$(xcrun --show-sdk-path 2>/dev/null)" || return 0
  sdk_major="$(xcrun --show-sdk-version 2>/dev/null | cut -d. -f1)" || return 0
  [[ "$os_major" =~ ^[0-9]+$ && "$sdk_major" =~ ^[0-9]+$ ]] || return 0
  (( sdk_major > os_major )) || return 0

  sdks_dir="$(dirname "$sdk_path")"
  candidate="$(ls -d "$sdks_dir"/MacOSX"$os_major"*.sdk 2>/dev/null | sort -V | tail -1)"
  [[ -n "$candidate" && -d "$candidate" ]] || return 0

  export SDKROOT="$candidate"
  note "SDKROOT=$SDKROOT (default SDK $sdk_path is newer than macOS $os_major)"
}

build_current() {
  need cabal
  ensure_sdkroot
  sync_source
  (
    cd "$ROOT"
    cabal build exe:main
  )
  BIN="$(cd "$ROOT" && cabal list-bin exe:main)"
}

cmd_build() {
  resolve_problem "${1:-}" "${2:-}"
  note "build $PROBLEM_ID"
  build_current
  printf '%s\n' "$BIN"
}

cmd_run() {
  resolve_problem "${1:-}" "${2:-}"
  note "run $PROBLEM_ID"
  build_current
  exec "$BIN"
}

cmd_test() {
  resolve_problem "${1:-}" "${2:-}"
  need oj
  note "test $PROBLEM_ID"
  build_current
  oj test --directory "$PROBLEM_DIR/test" --command "$BIN"
}

submit_current() {
  need oj
  note "submit $PROBLEM_ID -> $URL"
  oj submit "$URL" "$SRC"
}

cmd_submit() {
  resolve_problem "${1:-}" "${2:-}"
  cmd_test "$CONTEST_ID" "$PROBLEM_ID"
  submit_current
}

cmd_submit_only() {
  resolve_problem "${1:-}" "${2:-}"
  submit_current
}

# `hc new` used to run oj-prepare, which fetches every problem page three times
# in a row (HTML, samples, `oj download`) with no pause and hits AtCoder's rate
# limit (429 Too Many Requests), and whose input-format analysis is unused
# because templates/Main.hs is static. Instead: list the problems with one
# `oj-api` request, copy the template, and fetch the samples with a single,
# throttled and retried `oj download` per problem.
list_problem_urls() {
  oj-api get-contest "$1" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit("hc: oj-api returned invalid JSON")
if data.get("status") != "ok":
    sys.exit("hc: oj-api: " + "; ".join(data.get("messages") or ["unknown error"]))
for problem in data["result"]["problems"]:
    print(problem["url"])
'
}

download_samples() {
  local dir="$1"
  local url="$2"
  local attempt=1

  sleep "$REQUEST_INTERVAL"
  while ! ( cd "$dir" && oj download "$url" </dev/null ); do
    if (( attempt >= DOWNLOAD_ATTEMPTS )); then
      return 1
    fi
    note "download failed (attempt $attempt/$DOWNLOAD_ATTEMPTS); retrying in ${RETRY_WAIT}s: $url"
    sleep "$RETRY_WAIT"
    attempt=$((attempt + 1))
  done
}

# Existing files are kept, so rerunning `hc new` only fills in what is missing.
prepare_problem() {
  local dir="$1"
  local url="$2"

  mkdir -p "$dir"
  [[ -f "$dir/Main.hs" ]] || cp "$TEMPLATE_SRC" "$dir/Main.hs"
  has_samples "$dir" || download_samples "$dir" "$url"
  is_problem_dir "$dir" && has_samples "$dir"
}

cmd_new() {
  local contest="${1:-}"
  [[ -n "$contest" ]] || die "usage: hc new CONTEST_OR_URL"

  need oj
  need oj-api
  need python3

  local url
  if [[ "$contest" == http://* || "$contest" == https://* ]]; then
    url="$contest"
  else
    url="$(contest_url "$contest")"
  fi

  local contest_id
  contest_id="$(contest_id_from_url "$url")" \
    || die "not an AtCoder contest URL: $url"
  [[ -n "$contest_id" ]] || die "cannot determine the contest id from: $url"
  url="$(contest_url "$contest_id")"

  note "list problems: $url"
  local problem_urls
  problem_urls="$(list_problem_urls "$url")" \
    || die "cannot list the problems of $contest_id (not started yet, or not logged in? try: hc login)"
  [[ -n "$problem_urls" ]] || die "no problems found in $url"

  local contest_dir="$CONTESTS_DIR/$contest_id"
  local problem_url problem_id dir
  local prepared=0
  local broken=0

  while IFS= read -r problem_url; do
    problem_id="${problem_url##*/}"
    [[ "$problem_id" =~ ^[A-Za-z0-9_-]+$ ]] \
      || die "unexpected problem URL from oj-api: $problem_url"
    dir="$contest_dir/$problem_id"
    prepared=$((prepared + 1))

    note "prepare $problem_id"
    if ! prepare_problem "$dir" "$problem_url"; then
      broken=$((broken + 1))
      printf 'hc: incomplete problem directory: %s\n' "$dir" >&2
    fi
  done <<< "$problem_urls"

  [[ "$broken" -eq 0 ]] \
    || die "$broken of $prepared problem(s) under $contest_dir are incomplete; rerun 'hc new $contest_id' to retry"
  note "ready: $contest_dir ($prepared problems)"
}

cmd_login() {
  need oj
  oj login https://atcoder.jp/
}

cmd_doctor() {
  local failed=0
  local c

  printf '%-14s %s\n' "repository" "$ROOT"

  for c in ghc cabal python3 oj oj-api; do
    if command -v "$c" >/dev/null 2>&1; then
      case "$c" in
        ghc)        printf '%-14s %s\n' "$c" "$(ghc --numeric-version)" ;;
        cabal)      printf '%-14s %s\n' "$c" "$(cabal --numeric-version)" ;;
        python3)    printf '%-14s %s\n' "$c" "$(python3 --version 2>&1)" ;;
        oj)         printf '%-14s %s\n' "$c" "$(command -v oj)" ;;
        oj-api)     printf '%-14s %s\n' "$c" "$(command -v oj-api)" ;;
      esac
    else
      printf '%-14s MISSING\n' "$c"
      failed=1
    fi
  done

  if [[ "$(uname -s)" == "Darwin" ]] && command -v xcrun >/dev/null 2>&1; then
    local sdkroot_before="${SDKROOT:-}"
    ensure_sdkroot 2>/dev/null
    printf '%-14s %s\n' "macOS SDK" "${SDKROOT:-$(xcrun --show-sdk-path 2>/dev/null)}"
    if [[ -z "$sdkroot_before" && -n "${SDKROOT:-}" ]]; then
      printf '%-14s %s\n' "" "(pinned; the default SDK is too new for the installed linker)"
    fi
  fi

  if command -v ghc >/dev/null 2>&1; then
    local v
    v="$(ghc --numeric-version)"
    if [[ "$v" != "9.8.4" ]]; then
      printf '\nNote: AtCoder currently uses GHC 9.8.4; local GHC is %s.\n' "$v"
    fi
  fi

  return "$failed"
}

cmd_setup() {
  need cabal
  need oj

  mkdir -p "$ROOT/.build"
  cp "$TEMPLATE_SRC" "$BUILD_SRC"

  ensure_sdkroot

  note "initial Cabal build"
  (
    cd "$ROOT"
    cabal build exe:main
  )
}

cmd_clean() {
  rm -rf "$ROOT/.build" "$ROOT/dist-newstyle"
  mkdir -p "$ROOT/.build"
  : > "$ROOT/.build/.gitkeep"
}

cmd_list() {
  local contest="${1:-}"
  if [[ -z "$contest" ]]; then
    find "$CONTESTS_DIR" -mindepth 1 -maxdepth 1 -type d -print \
      | sed 's#.*/##' | sort
  else
    local dir="$CONTESTS_DIR/$contest"
    [[ -d "$dir" ]] || die "contest not found: $contest"
    find "$dir" -mindepth 1 -maxdepth 1 -type d -print \
      | sed 's#.*/##' | sort
  fi
}

cmd_open() {
  resolve_problem "${1:-}" "${2:-}"
  case "$(uname -s)" in
    Darwin) open "$URL" ;;
    Linux) xdg-open "$URL" ;;
    *) printf '%s\n' "$URL" ;;
  esac
}

usage() {
  cat <<'EOF'
Haskell + Cabal competitive-programming helper

Usage:
  hc setup
  hc doctor
  hc login
  hc new CONTEST_OR_URL

  hc build [TASK]
  hc run [TASK]
  hc test [TASK]
  hc submit [TASK]
  hc submit-only [TASK]
  hc open [TASK]

Task forms:
  Inside contests/abc473:
    hc test a

  Inside contests/abc473/abc473_a:
    hc test

  From anywhere:
    hc test abc473_a
    hc test abc473 a

Other:
  hc list [CONTEST]
  hc clean
  hc help

Typical workflow:
  hc new abc473
  cd contests/abc473
  hc test a
  hc submit a
EOF
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  setup)       cmd_setup "$@" ;;
  doctor)      cmd_doctor "$@" ;;
  login)       cmd_login "$@" ;;
  new)         cmd_new "$@" ;;
  build)       cmd_build "$@" ;;
  run)         cmd_run "$@" ;;
  test)        cmd_test "$@" ;;
  submit)      cmd_submit "$@" ;;
  submit-only) cmd_submit_only "$@" ;;
  open)        cmd_open "$@" ;;
  list)        cmd_list "$@" ;;
  clean)       cmd_clean "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$cmd' (try: hc help)" ;;
esac
