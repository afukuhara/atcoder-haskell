cabal-version:      3.0
name:               atcoder-hs
version:            0.1.0.0
build-type:         Simple

executable main
  main-is:          Main.hs
  hs-source-dirs:   .build
  default-language: GHC2021

  ghc-options:
    -O2
    -Wall
    -Wcompat
    -Wno-unused-imports
    -Wno-unused-matches
    -Wno-unused-top-binds

  build-depends:
      base >=4.17 && <5
    , ac-library-hs >=1.5 && <1.6
    , array >=0.5 && <0.6
    , attoparsec >=0.14 && <0.15
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.9
    , extra >=1.7 && <1.9
    , mtl >=2.2 && <2.4
    , primitive >=0.7 && <1.0
    , text >=2.0 && <2.2
    , unordered-containers >=0.2 && <0.3
    , vector >=0.12 && <0.14
